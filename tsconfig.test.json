{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "noEmit": false,
    "incremental": false,
    "plugins": []
  },
  "include": [
    "src/components/payment/**/*.ts",
    "src/components/payment/**/*.tsx",
    "src/components/wallet/**/*.ts",
    "src/components/wallet/**/*.tsx",
    "src/lib/**/*.ts",
    "src/wallet/**/*.ts",
    "src/app/docs/search.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["node_modules", ".test-build"]
}
